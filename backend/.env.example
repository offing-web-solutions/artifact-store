ENVIRONMENT=local
ALLOWED_ORIGINS=*
ROOT_PATH=

# Directorio donde se guardan los archivos. En Docker se monta como volumen.
# Bajo este directorio se crean: STORAGE_PATH/.metadata.db (SQLite) y
# STORAGE_PATH/{bucket}/... (archivos).
STORAGE_PATH=/data

# Clave para firmar URLs temporales. Generar con: openssl rand -hex 32
SIGNING_SECRET=cambia-esto-con-una-clave-aleatoria-larga

# URL pública del servicio, usada para construir las URLs firmadas
PUBLIC_BASE_URL=http://localhost:3008

# Tiempo de expiración por defecto para las URLs firmadas (segundos)
DEFAULT_EXPIRES_IN=3600
